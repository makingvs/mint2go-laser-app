{
  "name": "laser-zeichen-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Laser-Zeichen-App für Kinder (eigenständige iPad-Web-App, offline-fähig)",
  "scripts": {
    "dev": "vite",
    "dev:3d": "vite --config vite.3d.config.ts",
    "build": "tsc --noEmit && vite build && vite build --config vite.3d.config.ts && node scripts/make-sw.mjs && node scripts/make-sw.mjs 3d",
    "preview": "vite preview",
    "test": "vitest run",
    "start": "node server/server.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@fontsource-variable/baloo-2": "^5.3.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/rubik-mono-one": "^5.3.0",
    "three": "^0.170.0"
  }
}
